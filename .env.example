# ── Banco de Dados (prefixo PG_) ──
PG_HOST=192.168.0.250
PG_PORT=5432
PG_DBNAME=FABRICA
PG_USER=postgres
PG_SCHEMA=hfbrasil_preco

# Senha do banco:
# - Producao (Docker/Portainer): NAO defina aqui. Use um Docker secret com
#   PG_PASSWORD_FILE=/run/secrets/pg_password (ver docker-compose.yml).
# - Dev local: defina PG_PASSWORD abaixo OU crie o arquivo secrets/pg_password.
PG_PASSWORD=

# ── Pipeline ──
BASE_DIR=./dados
SITE_URL=https://www.hfbrasil.org.br/br/banco-de-dados-precos-medios-dos-hortifruticolas.aspx
PERIODICIDADE=Diario
HEADLESS=true
CANAL=console
